# Copy this file to .env and replace every secret value before first launch.
POSTGRES_DB=labcentral
POSTGRES_USER=labcentral
POSTGRES_PASSWORD=replace-with-a-64-character-random-hex-secret
FLAG_PEPPER=replace-with-a-different-64-character-random-hex-secret
SETUP_KEY=replace-with-a-third-64-character-random-hex-secret

# false supports plain HTTP on a trusted LAN. Set true behind HTTPS.
COOKIE_SECURE=false
LABCENTRAL_BIND_ADDRESS=0.0.0.0
LABCENTRAL_HTTP_PORT=8000
LABCENTRAL_HTTPS_PORT=443
PUBLIC_DOMAIN=http://:80

# Capacidad de aplicación por contenedor y conexiones PostgreSQL por worker.
APP_WORKERS=2
WORKER_MAX_CONCURRENCY=256
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4

# Backup automático dentro del servidor (copia también backups/ fuera del equipo).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_UID=1000
BACKUP_GID=1000
ATTEMPT_RETENTION_DAYS=90

# Recuperación de contraseña (opcional). Debe apuntar a un relay SMTP alcanzable.
# Para HTTPS, PUBLIC_BASE_URL debe ser el mismo dominio publicado por Caddy.
PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=8

# Archivos de retos: 5 MiB por archivo; cuota por evento en bytes (1 GiB por defecto).
ASSET_EVENT_QUOTA_BYTES=1073741824
MAX_CONCURRENT_UPLOADS=4
